<Project Sdk="MSTest.Sdk/4.0.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copy test data files to output directory -->
    <Content Include="TestData\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\GISLibrary\GISLibrary.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Update="MSTestSettings.cs">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Compile>
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.9.0" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.TrxReport" Version="2.3.2" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter" Version="4.3.2" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Update="MSTest.TestFramework" Version="4.3.2" />
  </ItemGroup>
</Project>
